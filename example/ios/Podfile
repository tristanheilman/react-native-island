ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'IslandExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Workaround for the `fmt` consteval build error under newer Xcode/Clang
    # (RN 0.79's folly pins an older fmt). fmt's base.h defines FMT_USE_CONSTEVAL
    # UNCONDITIONALLY from compiler detection (no #ifndef guard), so a
    # -DFMT_USE_CONSTEVAL=0 preprocessor define just gets redefined away. The only
    # reliable fix is to patch the header to force the value to 0 before it's used,
    # falling back to constexpr which compiles cleanly across Xcode versions.
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      contents = File.read(fmt_base)
      sentinel = '// rn-island: force-disable consteval'
      anchor = "#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval"
      if !contents.include?(sentinel) && contents.include?(anchor)
        patch = "#{sentinel}\n#undef FMT_USE_CONSTEVAL\n#define FMT_USE_CONSTEVAL 0\n#{anchor}"
        contents = contents.sub(anchor, patch)
        File.chmod(0644, fmt_base)
        File.write(fmt_base, contents)
        Pod::UI.puts 'Patched fmt/base.h to disable FMT_USE_CONSTEVAL'.green
      end
    end
  end
end
